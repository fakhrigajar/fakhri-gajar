# Required for the Express + MongoDB API (server/). Copy this file to .env
# for local development, or set these in your host's environment variables
# (e.g. Render's dashboard).

# The password you type in at /admin to log in.
ADMIN_PASSWORD=test

# Your MongoDB Atlas connection string.
MONGODB_URI=

# Database name to use within the cluster.
MONGODB_DB_NAME=portfolio

# Random secret used to sign admin JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the Express API listens on locally. Don't set this on Render — it
# injects its own PORT and the server already falls back to it.
PORT=4000
