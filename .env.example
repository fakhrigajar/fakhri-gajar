# Required for the /admin dashboard (netlify/functions/auth.mjs, content.mjs).
# Set both of these in your Netlify site's Environment Variables (Site settings
# > Environment variables), and copy this file to .env for local `netlify dev`.

# The password you type in at /admin to log in.
ADMIN_PASSWORD=test

# Random secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# Required for the Express + MongoDB API (server/). Copy this file to .env
# for local development, or set these in your host's environment variables.

# Your MongoDB Atlas connection string.
MONGODB_URI=

# Database name to use within the cluster.
MONGODB_DB_NAME=portfolio

# Random secret used to sign admin JWTs for the Express API. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the Express API listens on locally.
PORT=4000
